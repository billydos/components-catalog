# Сборочные артефакты
/catalogctl
/cmd/catalogctl/catalogctl
/qa/restsrv/restsrv
/qa/runner/runner

# Артефакты тестов и профилирования Go
*.test
*.prof
*.out
coverage*.txt

# Файлы баз данных SQLite и соседние WAL/SHM
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# …кроме фикстур миграций — бинарные базы-эталоны версий схемы
# коммитятся сознательно (план 09 §9); их соседние WAL/SHM-остатки
# (если возникли до фиксации файла) — всегда мусор
!qa/fixtures/*.sqlite
qa/fixtures/*.sqlite-wal
qa/fixtures/*.sqlite-shm

# Одноразовые данные прогонов QA (база нагрузки — реальный диск, не OS-temp)
/qa/tmp/

# Одноразовые данные работы с агентом (временные файлы, отчеты, кэш)
/work/tmp

# Логи
*.log
!qa/reports/*.log

# Локальное окружение
.env
.env.*

# Локальная Go-разработка
go.work
go.work.sum

# Go-кэш внутри дерева (конвенция GitLab-джоб: GOPATH=$CI_PROJECT_DIR/.go —
# GitLab кэширует только пути внутри каталога проекта). Игнорируется, чтобы
# не попадать в «файлы репозитория», по которым считается gofmt.
/.go/

# Артефакт отчёта GitLab-джобы (файл отчёта — *.log, каталог — для полноты)
/qa-artifact/

# Редакторы и ОС
.idea/
.vscode/
*.swp
.DS_Store

examples/embed/embed