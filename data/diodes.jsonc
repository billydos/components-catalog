  "diodes": [
    // gost (ГОСТ 10862-64): подкласс кодируется обозначением.
    {
      "name": "КДС111В",                     // сборка из двух выпрямительных диодов, общий катод
      "system": "gost",
      "attributes": {
        "description": "выпрямительная сборка", "spec": ["3.362.145ТУ"]
      },
      "sources": ["ds_kds111v"],
      "parameters": [
        { "parameter": "Vf", "max": 1.2, "If": 100 },
        { "parameter": "Ir", "max": 3, "Vr": 300 }
      ],
      "ratings": [
        { "parameter": "VrMax", "value": 300 },
        { "parameter": "IfMax", "value": 200 },
        { "parameter": "Temp", "min": -60, "max": 85 }
      ]
    },
    {
      "name": "КС168А",                      // стабилитрон 6,8 В: напряжение — в двух последних цифрах номера
      "system": "gost",
      "attributes": {
        "description": "стабилитрон", "package": "КД-4-1", "spec": ["СМ3.362.812ТУ"]
      },
      "sources": ["ds_ks168a"],
      "parameters": [
        { "parameter": "Vz", "min": 6.12, "max": 7.48, "Iz": 10 },
        { "parameter": "Rdiff", "max": 28, "Iz": 10 },
        { "parameter": "AlphaVz", "max": 0.06, "Iz": 10 }
      ],
      "ratings": [
        { "parameter": "Pmax", "value": 300 },
        { "parameter": "IzMin", "value": 3 },
        { "parameter": "IzMax", "value": 45 },
        { "parameter": "Temp", "min": -60, "max": 125 }
      ]
    },
    {
      "name": "АЛ307Б",                      // светодиод красный; Iv нормирован снизу (≥0,9 мкд) — диапазон в модель не ложится
      "system": "gost",
      "attributes": {
        "description": "светодиод", "spec": ["аА0.336.076ТУ"]
      },
      "sources": ["ds_al307b"],
      "parameters": [
        { "parameter": "Vf", "max": 2, "If": 10 },
        { "parameter": "Lambda", "min": 666, "max": 666 }        // λmax
