      ]
    },
    {
      "name": "АЛС324Б1",                    // семисегментный индикатор, высота знака 7,5 мм, красный; С — сборка (разбор), 1 — модернизация
      "system": "gost",
      "attributes": {
        "description": "одноразрядный семисегментный индикатор, высота знака 7,5 мм",
        "package": "КИ504"
      },
      "sources": ["ds_als324b1"],
      "parameters": [
        { "parameter": "Iv", "min": 0.15, "max": 0.45, "If": 20 },
        { "parameter": "Lambda", "min": 655, "max": 670 }
        // Uпр 2,5 В и Iпр.имп 300 мА: в источниках нет различимых условий нормировки (ток, tи/Q) — не сохраняются
      ],
      "ratings": [
        { "parameter": "VrMax", "value": 5 },
        { "parameter": "IfMax", "value": 25 },
        { "parameter": "Pmax", "value": 500 },
        { "parameter": "Temp", "min": -60, "max": 70 }
      ]
    },
    {
      "name": "АЛС333Б1",                    // семисегментный индикатор, высота знака 12 мм, красный
      "system": "gost",
      "attributes": {
        "description": "одноразрядный семисегментный индикатор, высота знака 12 мм",
        "package": "КИ504"
      },
      "sources": ["ds_als333b1"],
      "parameters": [
        { "parameter": "Lambda", "min": 650, "max": 670 }
