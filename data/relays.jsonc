{
  // Реле: выверенное наполнение; источники по каждой записи — код [S…]
  // и конфликты: docs/plan/08-data-verification.md §5. Единицы —
  // канонические: сопротивления — Ом, токи срабатывания — мА, времена — мс,
  // коммутируемый ток — А, мощности — Вт. Класс — только система other
  // (07-r1-verification.md §13): ключ — базовое обозначение типа;
  // исполнения обмотки (децимальные паспорта, суффиксы заказа) в ключ
  // не входят, VcoilNom у многовoltage семейств опущен, Rcoil — диапазон
  // сопротивлений обмоток исполнений.
  "relays": [
    // СССР: семейства РЭС/РПС/РКМ/МКУ/КДР — «код + номер разработки» [S19];
    // крепление/климат и децимальный номер исполнения в ключ не входят.
    {
      "name": "РЭС-9",
      "system": "other",
      "fields": { "series": "РЭС", "dev_number": 9 },
      "attributes": {
        "relayType": "electromagnetic", "contactForm": "2П",
        "description": "завальцованное негерметичное", "spec": "РС0.452.045ТУ",
        "datasheetUrl": "https://rudatasheet.ru/relay/res9/"
      },
      "parameters": [
        { "parameter": "Rcoil", "min": 30, "max": 9600 },        // обмотки исполнений РС4.529.029-00…-19
        { "parameter": "Ipickup", "max": 108 },                  // ток срабатывания (не более), мА
        { "parameter": "Rcontact", "max": 1.5 },
        { "parameter": "Rins", "min": 200000000 },
        { "parameter": "Vtest", "min": 500 },
        { "parameter": "tOperate", "max": 11 },
        { "parameter": "tRelease", "max": 7 }
      ],
      "ratings": [
        { "parameter": "VswitchMax", "value": 250 },
        { "parameter": "IswitchMax", "value": 3 },
        { "parameter": "TempMin", "value": -60 },
        { "parameter": "TempMax", "value": 85 }
      ],
      "dimensions": [ { "parameter": "massMax", "value": 20 } ]
