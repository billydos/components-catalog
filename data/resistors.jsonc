{
  // Резисторы: выверенное наполнение этапа 6 (план работ 6.2–6.3); ряд
  // мощностей С2-33Н — исполнениями с обязательным Pnom (D6). Источники —
  // код [S…] — и конфликты: docs/plan/08-data-verification.md §3. Сопротивление —
  // в Ом, мощность — в Вт, ТКС — в 10⁻⁶/°C.
  // Источники данных записей (D13): перенос атрибута datasheetUrl —
  // указатели на документацию несут urls источников типа datasheet.
  "sources": [
    { "code": "ds_cfr_25", "type": "datasheet", "title": "Datasheet: CFR-25 (www.datasheetarchive.com)", "urls": ["https://www.datasheetarchive.com/CFR-25-datasheet.html"] },
    { "code": "ds_mlt_0_5", "type": "datasheet", "title": "Datasheet: МЛТ-0.5 (www.radiolibrary.ru)", "urls": ["https://www.radiolibrary.ru/reference/resistor/mlt-0_5.html"] },
    { "code": "ds_pev_10", "type": "datasheet", "title": "Datasheet: ПЭВ-10 (eandc.ru)", "urls": ["https://eandc.ru/catalog/pev-10-10/"] },
    { "code": "ds_r1_4", "type": "datasheet", "title": "Datasheet: Р1-4 (l7805cv.ru)", "urls": ["http://l7805cv.ru/handbook-res-R1-4.html"] },
    { "code": "ds_rp1_46", "type": "datasheet", "title": "Datasheet: РП1-46 (www.155la3.ru)", "urls": ["http://www.155la3.ru/rp1_46.htm"] },
    { "code": "ds_s2_33n", "type": "datasheet", "title": "Datasheet: С2-33Н (l7805cv.ru)", "urls": ["http://l7805cv.ru/handbook-res-S2-33N.html"] },
    { "code": "ds_s5_16mv", "type": "datasheet", "title": "Datasheet: С5-16МВ (l7805cv.ru)", "urls": ["http://l7805cv.ru/handbook-res-S5-16MV.html"] },
    { "code": "ds_sp3_19a", "type": "datasheet", "title": "Datasheet: СП3-19А (www.ecworld.ru)", "urls": ["https://www.ecworld.ru/support/ssf/pot.htm"] },
    { "code": "ds_vs_0_5", "type": "datasheet", "title": "Datasheet: ВС-0.5 (www.155la3.ru)", "urls": ["http://www.155la3.ru/vs.htm"] }
  ],
  "resistors": [
