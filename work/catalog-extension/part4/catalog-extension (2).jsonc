// catalog-extension.jsonc — расширение каталога для справочника
// «Полупроводниковые приборы. Транзисторы малой мощности» (1989).
// Только коды, отсутствующие в стартовом наполнении, и переопределения
// действующих кодов по ревью catalog-extension-review.md (2026-11-22).
{
  "catalog": {
    "units": [
      // Микровольт — для шумового напряжения транзисторов.
      {"code": "uV"},
      // Микровольт на градус Цельсия — температурный уход разности напряжений затвор-исток у подобранных пар.
      {"code": "uV_per_degC"},
      // Наноампер на градус Цельсия — температурный коэффициент разности токов базы двух транзисторов сборки.
      {"code": "nA_per_degC"},
      // Спектральная плотность ЭДС шума (нВ/√Гц).
      {"code": "nV_per_sqrtHz"},
      // Фемтокулон — шумовой заряд.
      {"code": "fC"}
    ],
    "conditions": [
      // Напряжение между коллекторами двух транзисторов сборки.
      {"code": "Vc1c2", "unit": "V"},
      // Межбазовое напряжение однопереходного транзистора.
      {"code": "Vbb", "unit": "V"}
    ],
    "parameters": [
      // Коэффициент обратной связи по напряжению (h12): схемы ОБ и ОЭ —
      // наборами условий, по образцу h11 (консолидация h12b/h12e).
      {"code": "h12", "group": "electrical", "value_type": "at_most", "kinds": ["transistor"], "priority": "tertiary", "condition_sets": [{"items": [{"condition": "Ie", "mode": "required"}, {"condition": "Vcb", "mode": "required"}, {"condition": "freq", "mode": "optional"}]}, {"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Vce", "mode": "required"}, {"condition": "freq", "mode": "optional"}]}]},
      // Конструктивная ёмкость между выводами коллектора и эмиттера.
      {"code": "Cce", "group": "electrical", "value_type": "at_most", "unit": "pF", "kinds": ["transistor"], "priority": "tertiary"},
      // Индуктивность выводов (эмиттера и базы); каноническая единица мкГн.
      {"code": "Llead", "group": "electrical", "value_type": "exact", "unit": "uH", "kinds": ["transistor"], "priority": "tertiary"},
      // Максимальная рабочая частота транзистора (у конденсаторов — fMax).
      {"code": "fOpMax", "group": "electrical", "value_type": "exact", "unit": "Hz", "kinds": ["transistor"], "priority": "secondary"},
      // Оптимальный ток эмиттера, соответствующий максимальному усилению.
      {"code": "IeOpt", "group": "electrical", "value_type": "range", "unit": "mA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vcb", "mode": "required"}, {"condition": "freq", "mode": "required"}]}]},
      // Глубина регулирования коэффициента усиления по мощности.
      {"code": "GpAgc", "group": "electrical", "value_type": "at_least", "unit": "dB", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vcb", "mode": "required"}, {"condition": "freq", "mode": "required"}]}]},
      // Шумовое напряжение (в отличие от коэффициента шума NF).
      {"code": "Vn", "group": "electrical", "value_type": "at_most", "unit": "uV", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vds", "mode": "required"}, {"condition": "Id", "mode": "required"}]}, {"items": [{"condition": "Vce", "mode": "required"}, {"condition": "Ic", "mode": "required"}]}]},
      // Разность напряжений затвор-исток транзисторов подобранной пары.
      {"code": "VgsDiff", "group": "electrical", "value_type": "at_most", "unit": "mV", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vds", "mode": "required"}, {"condition": "Id", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Температурный уход разности напряжений затвор-исток пары.
      {"code": "TCVgsDiff", "group": "electrical", "value_type": "at_most", "unit": "uV_per_degC", "kinds": ["transistor"], "priority": "tertiary", "condition_sets": [{"items": [{"condition": "Vds", "mode": "required"}, {"condition": "Id", "mode": "required"}]}, {"items": [{"condition": "Vds", "mode": "optional"}, {"condition": "Id", "mode": "optional"}]}]},
      // Время установления.
      {"code": "tSettle", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Ib", "mode": "required"}]}]},
      // Ток стока при заданном (закрывающем) напряжении затвор-исток.
      {"code": "IdOff", "group": "electrical", "value_type": "limits", "unit": "mA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vds", "mode": "required"}, {"condition": "Vgs", "mode": "required"}]}]},
      // Ток порога (ток стока при пороговом напряжении; не ток затвора).
      {"code": "IdTh", "group": "electrical", "value_type": "at_least", "unit": "uA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vgs", "mode": "required"}, {"condition": "Vds", "mode": "required"}]}]},
      // Наибольшее напряжение коллектор-эмиттер при заданном Rбэ; условие Rbe вынесено в набор.
      {"code": "VcerMax", "group": "limiting", "unit": "V", "value_type": "exact", "kinds": ["transistor"], "priority": "primary", "condition_sets": [{"items": [{"condition": "Rbe", "mode": "required"}, {"condition": "Vce", "mode": "optional"}]}, {"items": [{"condition": "Rbe", "mode": "optional"}, {"condition": "Vce", "mode": "optional"}]}]},
      // Наибольшее импульсное напряжение коллектор-эмиттер при заданном Rбэ.
      {"code": "VcerPulseMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "tertiary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}, {"condition": "Rbe", "mode": "optional"}]}]},
      // Наибольшее напряжение затвор-сток.
      {"code": "VgdMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "secondary"},
      // Наибольшее отрицательное напряжение затвор-исток (дополняет VgsMax).
      {"code": "VgsMin", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "secondary"},
      // Наибольший постоянный ток коллектора в режиме насыщения.
      {"code": "IcSatMax", "group": "limiting", "value_type": "exact", "unit": "mA", "kinds": ["transistor"], "priority": "secondary"},
      // Тепловое сопротивление переход-корпус (уточняет Rth).
      {"code": "RthCase", "group": "limiting", "value_type": "exact", "unit": "degC_per_W", "kinds": ["transistor"], "priority": "secondary"},
      // Тепловое сопротивление переход-среда.
      {"code": "RthAmbient", "group": "limiting", "value_type": "exact", "unit": "degC_per_W", "kinds": ["transistor"], "priority": "secondary"},
      // Наибольшая температура корпуса.
      {"code": "TempCaseMax", "group": "limiting", "value_type": "exact", "unit": "degC", "kinds": ["transistor"], "priority": "secondary"},
      // Наибольшая импульсная рассеиваемая мощность стока (полевые).
      {"code": "PdPulseMax", "group": "limiting", "value_type": "exact", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}]}]},
      // Наибольшее импульсное напряжение сток-исток.
      {"code": "VdsPulseMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "tertiary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}]}]},
      // Наибольшее импульсное напряжение затвор-исток.
      {"code": "VgsPulseMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "tertiary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}]}]},
      // Коэффициент передачи однопереходного транзистора (η).
      {"code": "EtaUjt", "group": "electrical", "value_type": "limits", "kinds": ["transistor"], "priority": "primary", "condition_sets": [{"items": [{"condition": "temp", "mode": "optional"}]}]},
      // Предельная частота генерации однопереходного транзистора.
      {"code": "fGen", "group": "electrical", "value_type": "at_least", "unit": "Hz", "kinds": ["transistor"], "priority": "secondary"},
      // Напряжение насыщения эмиттер-база1 однопереходного транзистора.
      {"code": "Veb1Sat", "group": "electrical", "value_type": "at_most", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ie", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Ток включения (пиковый ток) однопереходного транзистора.
      {"code": "Ipeak", "group": "electrical", "value_type": "limits", "unit": "uA", "kinds": ["transistor"], "priority": "secondary"},
      // Ток выключения (ток впадины) однопереходного транзистора.
      {"code": "Ivalley", "group": "electrical", "value_type": "limits", "unit": "uA", "kinds": ["transistor"], "priority": "secondary"},
      // Межбазовое сопротивление однопереходного транзистора.
      {"code": "Rbb", "group": "electrical", "value_type": "range", "unit": "ohm", "kinds": ["transistor"], "priority": "primary", "condition_sets": [{"items": [{"condition": "temp", "mode": "optional"}]}]},
      // Межбазовое напряжение (предельное).
      {"code": "VbbMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "secondary"},
      // Импульсный ток эмиттера.
      {"code": "IePulseMax", "group": "limiting", "value_type": "exact", "unit": "mA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}]}]},
      // Сопротивление открытого ключа (биполярный ключ).
      {"code": "Ron", "group": "electrical", "value_type": "at_most", "unit": "ohm", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Ib", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}, {"items": [{"condition": "Ie", "mode": "required"}, {"condition": "Ib", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Асимметрия сопротивления открытого ключа.
      {"code": "RonMismatch", "group": "electrical", "value_type": "at_most", "unit": "pct", "kinds": ["transistor"], "priority": "tertiary"},
      // Время включения ключа при заданной схеме (условия — notes).
      {"code": "tonKey", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary"},
      // Время выключения ключа при заданной схеме (условия — notes).
      {"code": "toffKey", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary"},
      // Время включения однопереходного транзистора.
      {"code": "tonUjt", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "temp", "mode": "optional"}]}]},
      // Ток модуляции однопереходного транзистора.
      {"code": "Imod", "group": "electrical", "value_type": "at_least", "unit": "mA", "kinds": ["transistor"], "priority": "secondary"},
      // Температурный коэффициент межбазового сопротивления.
      {"code": "TCRbb", "group": "electrical", "value_type": "limits", "unit": "pct_per_degC", "kinds": ["transistor"], "priority": "tertiary", "allow_negative": true},
      // Наибольшая рассеиваемая мощность эмиттера (однопереходный).
      {"code": "PeMax", "group": "limiting", "value_type": "exact", "unit": "mW", "kinds": ["transistor"], "priority": "secondary"},
      // Время нарастания импульса.
      {"code": "tr", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary"},
      // Время спада импульса.
      {"code": "tf", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary"},
      // Время задержки импульса.
      {"code": "td", "group": "electrical", "value_type": "at_most", "unit": "ns", "kinds": ["transistor"], "priority": "secondary"},
      // Импульсное входное сопротивление в режиме большого сигнала.
      {"code": "RinPulse", "group": "electrical", "value_type": "range", "unit": "ohm", "kinds": ["transistor"], "priority": "tertiary", "condition_sets": [{"items": [{"condition": "Vce", "mode": "required"}, {"condition": "Ic", "mode": "required"}]}]},
      // Наибольший средний ток коллектора.
      {"code": "IcAvgMax", "group": "limiting", "value_type": "exact", "unit": "mA", "kinds": ["transistor"], "priority": "secondary"},
      // Коэффициент линейности: отношение h21э при малом и большом токе эмиттера (формула — в примечании записи).
      {"code": "linearity", "group": "electrical", "value_type": "range", "kinds": ["transistor"], "priority": "secondary"},
      // Прямое падение напряжения на эмиттерном переходе при отключённом коллекторе.
      {"code": "VebForward", "group": "electrical", "value_type": "at_most", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ie", "mode": "required"}]}]},
      // Сопротивление базы (rб); условия могут не указываться.
      {"code": "Rb", "group": "electrical", "value_type": "at_most", "unit": "ohm", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vcb", "mode": "optional"}, {"condition": "Ie", "mode": "optional"}, {"condition": "freq", "mode": "optional"}]}]},
      // Пробивное напряжение коллектор-эмиттер при заданном обратном токе коллектора (не менее); отличается от граничного напряжения VceCutoff.
      {"code": "VbrCeo", "group": "electrical", "value_type": "at_least", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}]}]},
      // Выходная полная проводимость в схеме ОЭ (h22э).
      {"code": "h22e", "group": "electrical", "value_type": "at_most", "unit": "uS", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Vce", "mode": "required"}, {"condition": "freq", "mode": "optional"}]}]},
      // Пробивное напряжение эмиттер-база при заданном токе эмиттера.
      {"code": "VbrEbo", "group": "electrical", "value_type": "at_least", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ie", "mode": "required"}]}]},
      // Падение напряжения на открытом ключе.
      {"code": "VonKey", "group": "electrical", "value_type": "at_most", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ib", "mode": "required"}, {"condition": "Ic", "mode": "optional"}, {"condition": "temp", "mode": "optional"}]}]},
      // Ток закрытого ключа.
      {"code": "IoffKey", "group": "electrical", "value_type": "at_most", "unit": "uA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "temp", "mode": "optional"}]}]},
      // Напряжение на управляющих переходах.
      {"code": "Vcontrol", "group": "electrical", "value_type": "at_most", "unit": "V", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ib", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Предельное напряжение управления коллектор-база структуры.
      {"code": "VcbControlMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "secondary"},
      // Предельное напряжение на закрытом ключе между эмиттерами.
      {"code": "VeeoMax", "group": "limiting", "value_type": "exact", "unit": "V", "kinds": ["transistor"], "priority": "secondary"},
      // Сопротивление коллектор-база.
      {"code": "Rcb", "group": "electrical", "value_type": "at_most", "unit": "ohm", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vcb", "mode": "required"}, {"condition": "Ie", "mode": "required"}, {"condition": "freq", "mode": "optional"}]}]},
      // Непрерывная СВЧ-мощность в цепи эмиттер-база.
      {"code": "PebCwMax", "group": "limiting", "value_type": "exact", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "freq", "mode": "optional"}, {"condition": "temp", "mode": "optional"}]}]},
      // Импульсная СВЧ-мощность в цепи эмиттер-база.
      {"code": "PebPulseMax", "group": "limiting", "value_type": "exact", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Обратный ток коллектор-эмиттер при короткозамкнутой цепи база-эмиттер (Rбэ=0).
      {"code": "Ices", "group": "electrical", "value_type": "at_most", "unit": "uA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Vce", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Наибольшая допустимая входная СВЧ-мощность (непрерывная).
      {"code": "PinMax", "group": "limiting", "value_type": "at_most", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "freq", "mode": "optional"}, {"condition": "temp", "mode": "optional"}]}]},
      // Наибольшая импульсная входная СВЧ-мощность.
      {"code": "PinPulseMax", "group": "limiting", "value_type": "at_most", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}, {"condition": "freq", "mode": "optional"}, {"condition": "temp", "mode": "optional"}]}]},
      // Наибольшая средняя входная СВЧ-мощность.
      {"code": "PinAvgMax", "group": "limiting", "value_type": "at_most", "unit": "mW", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "freq", "mode": "optional"}, {"condition": "temp", "mode": "optional"}]}]},
      // Ток утечки между транзисторами сборки.
