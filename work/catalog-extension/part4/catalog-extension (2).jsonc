      // Наибольший импульсный ток базы.
      {"code": "IbPulseMax", "group": "limiting", "value_type": "exact", "unit": "mA", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "pulse_duration", "mode": "required"}]}]},
      // Отношение статических коэффициентов передачи тока двух транзисторов подобранной пары/сборки.
      {"code": "hfeRatio", "group": "electrical", "value_type": "limits", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Vce", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}, {"items": [{"condition": "Ie", "mode": "required"}, {"condition": "Vce", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}, {"items": [{"condition": "Ie", "mode": "required"}, {"condition": "Vcb", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}, {"items": [{"condition": "Ic", "mode": "required"}, {"condition": "Vcb", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Разность напряжений база-эмиттер двух транзисторов пары/сборки.
