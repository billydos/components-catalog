      // Разность напряжений коллектор-база двух транзисторов пары/сборки.
      {"code": "VcbDiff", "group": "electrical", "value_type": "at_most", "unit": "mV", "kinds": ["transistor"], "priority": "secondary", "condition_sets": [{"items": [{"condition": "Ic", "mode": "required"}, {"condition": "temp", "mode": "optional"}]}]},
      // Напряжение лавинного пробоя.
      {"code": "VbrAvalanche", "group": "electrical", "value_type": "at_least", "unit": "V", "kinds": ["transistor"], "priority": "secondary"},
      // Ток коллектора в лавинном режиме (предельный).
