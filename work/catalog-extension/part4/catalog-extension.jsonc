// catalog-extension.jsonc — расширение каталога для справочника
// «Полупроводниковые приборы. Транзисторы малой мощности» (1989).
// Только коды, отсутствующие в стартовом наполнении (class-keys.md,
// fill-format.md). Сид не дублируется.
{
  "catalog": {
    // Микровольт — для шумового напряжения транзисторов (в сиде нет).
    "units": [
      { "code": "uV" },
      // Микровольт на градус Цельсия — температурный уход разности
      // напряжений затвор-исток у подобранных пар.
      { "code": "uV_per_degC" },
      // Наноампер на градус Цельсия — температурный коэффициент разности
      // токов базы двух транзисторов сборки.
      { "code": "nA_per_degC" },
      // Спектральная плотность ЭДС шума (нВ/√Гц).
      { "code": "nV_per_sqrtHz" },
      // Фемтокулон — шумовой заряд.
      { "code": "fC" }
    ],
    // Напряжение между коллекторами двух транзисторов сборки.
    "conditions": [
      { "code": "Vc1c2", "unit": "V" },
      { "code": "Vcc", "unit": "V" }
    ],
    "parameters": [
      // Коэффициент передачи тока в режиме малого сигнала в схеме ОЭ
      // (|h21э|); отличается от статического hfe режимом измерения.
      {
        "code": "h21e", "group": "electrical", "value_type": "limits",
        "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vce", "mode": "required" }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vce", "mode": "required" }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vce", "mode": "required", "fixed_value": 0 }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vce", "mode": "required", "fixed_value": 0 }, { "condition": "freq", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Входное сопротивление в схеме ОБ в режиме малого сигнала (h11б).
      {
        "code": "h11b", "group": "electrical", "value_type": "at_most",
        "unit": "ohm", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "optional" } ] }
        ]
      },
      // Коэффициент обратной связи по напряжению в схеме ОБ (h12б).
      {
        "code": "h12b", "group": "electrical", "value_type": "at_most",
        "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "optional" } ] }
        ]
      },
      // Коэффициент обратной связи по напряжению в схеме ОЭ (h12э).
      {
        "code": "h12e", "group": "electrical", "value_type": "at_most",
        "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vce", "mode": "required" }, { "condition": "freq", "mode": "optional" } ] }
        ]
      },
      // Постоянная времени цепи обратной связи (τос).
      {
        "code": "TauOs", "group": "electrical", "value_type": "at_most",
        "unit": "ps", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "optional" } ] }
        ]
      },
      // Конструктивная ёмкость между выводами коллектора и эмиттера.
      {
        "code": "Cce", "group": "electrical", "value_type": "at_most",
        "unit": "pF", "kinds": ["transistor"], "priority": "tertiary"
      },
      // Индуктивность выводов (эмиттера и базы); каноническая единица мкГн.
      {
        "code": "Llead", "group": "electrical", "value_type": "exact",
        "unit": "uH", "kinds": ["transistor"], "priority": "tertiary"
      },
      // Граничная частота коэффициента передачи тока, нормируемая сверху
      // («не более»); дополняет fT (at_least) для низкочастотных приборов.
      {
        "code": "fTMax", "group": "electrical", "value_type": "at_most",
        "unit": "Hz", "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vce", "mode": "required" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vcb", "mode": "required" } ] },
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Vcb", "mode": "required" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Vce", "mode": "required" } ] },
          { "items": [ { "condition": "Ic", "mode": "optional" }, { "condition": "Vce", "mode": "optional" }, { "condition": "Ie", "mode": "optional" }, { "condition": "Vcb", "mode": "optional" } ] }
        ]
      },
      // Максимальная рабочая частота транзистора (у конденсаторов — fMax).
      {
        "code": "fOpMax", "group": "electrical", "value_type": "exact",
        "unit": "Hz", "kinds": ["transistor"], "priority": "secondary"
      },
      // Оптимальный ток эмиттера, соответствующий максимальному усилению.
      {
        "code": "IeOpt", "group": "electrical", "value_type": "range",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "required" } ] }
        ]
      },
      // Глубина регулирования коэффициента усиления по мощности.
      {
        "code": "GpControl", "group": "electrical", "value_type": "at_least",
        "unit": "dB", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vcb", "mode": "required" }, { "condition": "freq", "mode": "required" } ] }
        ]
      },
      // Шумовое напряжение (в отличие от коэффициента шума NF).
      {
        "code": "Vn", "group": "electrical", "value_type": "at_most",
        "unit": "uV", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Id", "mode": "required" } ] },
          { "items": [ { "condition": "Vce", "mode": "required" }, { "condition": "Ic", "mode": "required" } ] }
        ]
      },
      // Разность напряжений затвор-исток транзисторов подобранной пары.
      {
        "code": "VgsDiff", "group": "electrical", "value_type": "at_most",
        "unit": "mV", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Id", "mode": "required" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Температурный уход разности напряжений затвор-исток пары.
      {
        "code": "TCRVgsDiff", "group": "electrical", "value_type": "at_most",
        "unit": "uV_per_degC", "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Id", "mode": "required" } ] },
          { "items": [ { "condition": "Vds", "mode": "optional" }, { "condition": "Id", "mode": "optional" } ] }
        ]
      },
      // Время установления.
      {
        "code": "tSetup", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Ib", "mode": "required" } ] }
        ]
      },
      // Напряжение отсечки, нормируемое сверху/снизу (дополняет range VgsOff).
      {
        "code": "VgsOffMax", "group": "electrical", "value_type": "at_most",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Id", "mode": "required" }, { "condition": "Vds", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      {
        "code": "VgsOffMin", "group": "electrical", "value_type": "at_least",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Id", "mode": "required" }, { "condition": "Vds", "mode": "optional" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Пороговое напряжение, нормируемое сверху/снизу (дополняет range VgsTh).
      {
        "code": "VgsThMax", "group": "electrical", "value_type": "at_most",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Id", "mode": "required" }, { "condition": "Vds", "mode": "optional" } ] }
        ]
      },
      {
        "code": "VgsThMin", "group": "electrical", "value_type": "at_least",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Id", "mode": "required" }, { "condition": "Vds", "mode": "optional" } ] }
        ]
      },
      // Начальный ток стока, нормируемый сверху/снизу (дополняет range Idss).
      {
        "code": "IdssMax", "group": "electrical", "value_type": "at_most",
        "unit": "mA", "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Vgs", "mode": "required", "fixed_value": 0 }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      {
        "code": "IdssMin", "group": "electrical", "value_type": "at_least",
        "unit": "mA", "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Vgs", "mode": "required", "fixed_value": 0 }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Ток стока при заданном (закрывающем) напряжении затвор-исток.
      {
        "code": "IdOff", "group": "electrical", "value_type": "range",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vds", "mode": "required" }, { "condition": "Vgs", "mode": "required" } ] }
        ]
      },
      // Ток порога (ток затвора при пороговом напряжении).
      {
        "code": "IgTh", "group": "electrical", "value_type": "at_least",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Vgs", "mode": "required" }, { "condition": "Vds", "mode": "required" } ] }
        ]
      },
      // Наибольшее напряжение коллектор-эмиттер при заданном сопротивлении
      // в цепи база-эмиттер (V_CER); условие Rбэ — в notes.
      {
        "code": "VcerMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "priority": "primary"
      },
      {
        "code": "VcerPulseMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "pulse_duration", "mode": "required" }, { "condition": "Rbe", "mode": "optional" } ] }
        ]
      },
      // Наибольшее напряжение затвор-сток.
      {
        "code": "VgdMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "priority": "secondary"
      },
      // Наибольшее отрицательное напряжение затвор-исток (дополняет VgsMax).
      {
        "code": "VgsMin", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "secondary"
      },
      // Наибольший постоянный ток коллектора в режиме насыщения.
      {
        "code": "IcSatMax", "group": "limiting", "value_type": "exact",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Тепловое сопротивление переход-корпус / переход-среда (уточняют Rth).
      {
        "code": "RthCase", "group": "limiting", "value_type": "exact",
        "unit": "degC_per_W", "kinds": ["transistor"], "priority": "secondary"
      },
      {
        "code": "RthAmbient", "group": "limiting", "value_type": "exact",
        "unit": "degC_per_W", "kinds": ["transistor"], "priority": "secondary"
      },
      // Наибольшая температура корпуса.
      {
        "code": "TempCaseMax", "group": "limiting", "value_type": "exact",
        "unit": "degC", "kinds": ["transistor"], "priority": "secondary"
      },
      // Импульсные предельные данные полевых транзисторов.
      {
        "code": "PdPulseMax", "group": "limiting", "value_type": "exact",
        "unit": "mW", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "pulse_duration", "mode": "required" } ] }
        ]
      },
      {
        "code": "VdsPulseMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "pulse_duration", "mode": "required" } ] }
        ]
      },
      {
        "code": "VgsPulseMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "allow_negative": true, "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "pulse_duration", "mode": "required" } ] }
        ]
      },
      // Коэффициент передачи однопереходного транзистора (η).
      {
        "code": "EtaUjt", "group": "electrical", "value_type": "limits",
        "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Предельная частота генерации однопереходного транзистора.
      {
        "code": "fGen", "group": "electrical", "value_type": "at_least",
        "unit": "Hz", "kinds": ["transistor"], "priority": "secondary"
      },
      // Напряжение насыщения эмиттер-база1 однопереходного транзистора.
      {
        "code": "Veb1Sat", "group": "electrical", "value_type": "at_most",
        "unit": "V", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Ток включения (пиковый ток) однопереходного транзистора.
      {
        "code": "Ipeak", "group": "electrical", "value_type": "range",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Ток выключения (ток впадины) однопереходного транзистора.
      {
        "code": "Ivalley", "group": "electrical", "value_type": "range",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Межбазовое сопротивление однопереходного транзистора.
      {
        "code": "Rbb", "group": "electrical", "value_type": "range",
        "unit": "ohm", "kinds": ["transistor"], "priority": "primary",
        "condition_sets": [
          { "items": [ { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Межбазовое напряжение (предельное).
      {
        "code": "VbbMax", "group": "limiting", "value_type": "exact",
        "unit": "V", "kinds": ["transistor"], "priority": "secondary"
      },
      // Импульсный ток эмиттера.
      {
        "code": "IePulseMax", "group": "limiting", "value_type": "exact",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "pulse_duration", "mode": "required" } ] }
        ]
      },
      // Сопротивление открытого ключа (биполярный ключ).
      {
        "code": "Ron", "group": "electrical", "value_type": "at_most",
        "unit": "ohm", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "Ic", "mode": "required" }, { "condition": "Ib", "mode": "required" }, { "condition": "temp", "mode": "optional" } ] },
          { "items": [ { "condition": "Ie", "mode": "required" }, { "condition": "Ib", "mode": "required" }, { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Асимметрия сопротивления открытого ключа.
      {
        "code": "RonMismatch", "group": "electrical", "value_type": "at_most",
        "unit": "pct", "kinds": ["transistor"], "priority": "tertiary"
      },
      // Время включения/выключения ключа при заданной схеме (условия — notes).
      {
        "code": "tonKey", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary"
      },
      {
        "code": "toffKey", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary"
      },
      // Время включения однопереходного транзистора.
      {
        "code": "tonUjt", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Ток включения, нормируемый сверху.
      {
        "code": "IpeakMax", "group": "electrical", "value_type": "at_most",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Ток выключения, нормируемый снизу.
      {
        "code": "IvalleyMin", "group": "electrical", "value_type": "at_least",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Обратный ток эмиттера однопереходного транзистора (межбазовое
      // напряжение вместо Uэб).
      {
        "code": "IeboUjt", "group": "electrical", "value_type": "at_most",
        "unit": "uA", "kinds": ["transistor"], "priority": "secondary",
        "condition_sets": [
          { "items": [ { "condition": "temp", "mode": "optional" } ] }
        ]
      },
      // Ток модуляции однопереходного транзистора.
      {
        "code": "Imod", "group": "electrical", "value_type": "at_least",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Температурный коэффициент межбазового сопротивления.
      {
        "code": "TCRbb", "group": "electrical", "value_type": "limits",
        "unit": "pct_per_degC", "kinds": ["transistor"], "priority": "tertiary"
      },
      // Наибольшая рассеиваемая мощность эмиттера (однопереходный).
      {
        "code": "PeMax", "group": "limiting", "value_type": "exact",
        "unit": "mW", "kinds": ["transistor"], "priority": "secondary"
      },
      // Время нарастания/спада/задержки импульса.
      {
        "code": "tr", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary"
      },
      {
        "code": "tf", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary"
      },
      {
        "code": "td", "group": "electrical", "value_type": "at_most",
        "unit": "ns", "kinds": ["transistor"], "priority": "secondary"
      },
      // Импульсное входное сопротивление в режиме большого сигнала.
      {
        "code": "RinPulse", "group": "electrical", "value_type": "range",
        "unit": "ohm", "kinds": ["transistor"], "priority": "tertiary",
        "condition_sets": [
          { "items": [ { "condition": "Vce", "mode": "required" }, { "condition": "Ic", "mode": "required" } ] }
        ]
      },
      // Наибольший средний ток коллектора.
      {
        "code": "IcAvgMax", "group": "limiting", "value_type": "exact",
        "unit": "mA", "kinds": ["transistor"], "priority": "secondary"
      },
      // Коэффициент линейности: отношение h21э при малом и большом токе
      // эмиттера (формула — в примечании записи).
      {
        "code": "Klin", "group": "electrical", "value_type": "range",
